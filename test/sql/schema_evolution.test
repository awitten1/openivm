statement ok
CREATE SCHEMA generated_views;
CREATE TABLE generated_views.s(k INTEGER,v INTEGER,g INTEGER GENERATED ALWAYS AS(v*2));
INSERT INTO generated_views.s(k,v) VALUES(1,2),(1,2),(2,3);
CREATE VIEW generated_views.inner_view AS SELECT k,g FROM generated_views.s;
CREATE VIEW generated_views.named_view(id,value) AS SELECT k,g FROM generated_views.inner_view;
CREATE TABLE s(k INTEGER,v INTEGER,g INTEGER);
INSERT INTO s VALUES(99,99,99);
CREATE MATERIALIZED VIEW generated_view_mv AS SELECT id,SUM(value) total FROM generated_views.named_view GROUP BY id;
CREATE MATERIALIZED VIEW generated_view_join_mv AS SELECT a.id,a.value,b.value other FROM generated_views.named_view a JOIN generated_views.named_view b ON a.id=b.id;
CREATE MATERIALIZED VIEW generated_view_cte_mv AS WITH s AS (SELECT 999 AS k,999 AS g) SELECT id,value FROM generated_views.named_view;
CREATE MATERIALIZED VIEW generated_alias_mv AS SELECT a,SUM(c) total FROM generated_views.s AS x(a,b,c) GROUP BY a;
CREATE MATERIALIZED VIEW generated_unused_alias_mv AS SELECT a,SUM(b) total FROM generated_views.s AS x(a,b,c) GROUP BY a;
CREATE MATERIALIZED VIEW generated_view_alias_mv AS SELECT a,SUM(b) total FROM generated_views.named_view AS x(a,b) GROUP BY a;
CREATE MATERIALIZED VIEW generated_values_mv AS SELECT * FROM (VALUES ((SELECT SUM(g) FROM generated_views.s))) q(total);

