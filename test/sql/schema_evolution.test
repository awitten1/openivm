# ==========================================
# Test 15: failed rename restores exact metadata
# ==========================================

statement ok
CREATE TABLE se_failed_rename_src (id INTEGER, old_col INTEGER, new_col INTEGER);

statement ok
INSERT INTO se_failed_rename_src VALUES (1, 10, 100), (2, 20, 200);

statement ok
CREATE MATERIALIZED VIEW se_failed_rename_mv AS
SELECT id, old_col AS old_value, new_col AS new_value
FROM se_failed_rename_src;

statement error
ALTER TABLE se_failed_rename_src RENAME COLUMN old_col TO new_col;
----
already exists

# Batch conflicting changes before one refresh. A lossy new_col -> old_col
# rollback rewrite makes the two projected values equal and fails bag equality.
statement ok
INSERT INTO se_failed_rename_src VALUES (3, 30, 300), (4, 40, 400);

statement ok
UPDATE se_failed_rename_src
SET old_col = old_col + 1, new_col = new_col + 2
WHERE id IN (1, 3);

statement ok
DELETE FROM se_failed_rename_src WHERE id IN (2, 4);

statement ok
PRAGMA refresh('se_failed_rename_mv');

query I
SELECT count(*) FROM (
    SELECT * FROM se_failed_rename_mv
    EXCEPT ALL
    SELECT id, old_col AS old_value, new_col AS new_value
    FROM se_failed_rename_src
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, old_col AS old_value, new_col AS new_value
    FROM se_failed_rename_src
    EXCEPT ALL
    SELECT * FROM se_failed_rename_mv
);
----
0

# A helper connection cannot see a delta table created in the caller transaction.
# Schema synchronization must use the caller's catalog snapshot.
statement ok
BEGIN;

statement ok
CREATE TABLE se_uncommitted_src (id INTEGER, v INTEGER);

statement ok
INSERT INTO se_uncommitted_src VALUES (1, 10), (1, 10), (2, NULL);

statement ok
CREATE MATERIALIZED VIEW se_uncommitted_mv AS SELECT id, v FROM se_uncommitted_src;

statement ok
ALTER TABLE se_uncommitted_src ADD COLUMN extra INTEGER DEFAULT 7;

statement ok
SELECT extra FROM openivm_delta_se_uncommitted_src LIMIT 0;

statement ok
INSERT INTO se_uncommitted_src VALUES (1, 10, 8), (3, NULL, 9);

statement ok
DELETE FROM se_uncommitted_src WHERE id = 2;

statement ok
UPDATE se_uncommitted_src SET v = 20 WHERE id = 1;

statement ok
COMMIT;

statement ok
PRAGMA refresh('se_uncommitted_mv');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM se_uncommitted_mv EXCEPT ALL SELECT id, v FROM se_uncommitted_src)),
       (SELECT count(*) FROM (SELECT id, v FROM se_uncommitted_src EXCEPT ALL SELECT * FROM se_uncommitted_mv));
----
0	0



# Same-named physical sources must retain distinct delta identities.
statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE SCHEMA source_a;

statement ok
