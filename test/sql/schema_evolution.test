# A failed native replacement must roll back its preimage deltas and incarnation
# invalidation, even if the caller attempts COMMIT after the execution error.
statement ok
CREATE TABLE failed_ctas_parent(k INTEGER PRIMARY KEY);
CREATE TABLE failed_ctas_child(k INTEGER REFERENCES failed_ctas_parent(k));
INSERT INTO failed_ctas_parent VALUES(1);
INSERT INTO failed_ctas_child VALUES(1);
CREATE MATERIALIZED VIEW failed_ctas_mv AS SELECT k FROM failed_ctas_parent;

statement ok
