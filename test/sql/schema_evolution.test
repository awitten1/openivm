ATTACH ':memory:' AS generated_peer;
CREATE SCHEMA generated_peer.generated_lookup;
CREATE TABLE generated_peer.generated_lookup.s(k INTEGER,v INTEGER,g INTEGER GENERATED ALWAYS AS(v*2));
INSERT INTO generated_peer.generated_lookup.s(k,v) VALUES(1,2),(1,2);
USE generated_peer.main;
CREATE VIEW v AS SELECT k,g FROM generated_lookup.s;
USE memory.main;
CREATE MATERIALIZED VIEW generated_peer_view_mv AS SELECT k,SUM(g) total FROM generated_peer.main.v GROUP BY k;
INSERT INTO generated_peer.generated_lookup.s(k,v) VALUES(2,3),(3,4);
UPDATE generated_peer.generated_lookup.s SET v=v+1 WHERE k=1;
DELETE FROM generated_peer.generated_lookup.s WHERE k=3;

