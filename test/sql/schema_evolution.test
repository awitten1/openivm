statement ok
CREATE MATERIALIZED VIEW generated_join AS SELECT a.k,a.g,b.g AS bg FROM "Generated.Schema"."Values" a JOIN "Generated.Schema"."Values" b ON a.k=b.k AND a.g=b.g;

statement ok
CREATE MATERIALIZED VIEW generated_expression AS SELECT k,v*2 AS manual FROM "Generated.Schema"."Values";

statement ok
CREATE MATERIALIZED VIEW generated_cte AS WITH "Values" AS (SELECT * FROM "Generated.Schema"."Values") SELECT k,g FROM "Values";

statement ok
