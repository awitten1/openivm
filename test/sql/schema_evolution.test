UNION ALL (SELECT * FROM original_ctas_token EXCEPT ALL SELECT generation FROM main.openivm_source_generations WHERE table_name='failed_ctas_parent'));
----
0

statement ok
PRAGMA refresh('failed_ctas_mv');

query I
SELECT count(*) FROM ((SELECT * FROM failed_ctas_mv EXCEPT ALL SELECT * FROM failed_ctas_parent)
UNION ALL (SELECT * FROM failed_ctas_parent EXCEPT ALL SELECT * FROM failed_ctas_mv));
----
0

# Untracked CTAS retains DuckDB's native insertion-order/batch strategy.
statement ok
SET preserve_insertion_order=true;
SET threads=4;
CREATE TABLE ordered_untracked_ctas AS SELECT i FROM range(100000) r(i);

query I
SELECT bool_and(i=rn-1) FROM (SELECT i,row_number() OVER() rn FROM ordered_untracked_ctas);
----
true

