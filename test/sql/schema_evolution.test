statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM (
    SELECT val, total, cnt FROM mv
    EXCEPT ALL
    SELECT amount AS val, SUM(amount), COUNT(*) FROM t GROUP BY amount
);
----
0

query I
SELECT count(*) FROM (
    SELECT amount AS val, SUM(amount), COUNT(*) FROM t GROUP BY amount
    EXCEPT ALL
    SELECT val, total, cnt FROM mv
