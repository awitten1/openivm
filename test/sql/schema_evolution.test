statement ok
CREATE TEMP TABLE original_ctas_token AS SELECT generation FROM main.openivm_source_generations WHERE table_name='failed_ctas_parent';
BEGIN;

statement error
CREATE OR REPLACE TABLE failed_ctas_parent AS SELECT 2::INTEGER k;
----
depend

statement ok
COMMIT;

