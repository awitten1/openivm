# Original-SQL window fallback must retain each public source identity, rather than
# reconstructing it from physical scan names while the metadata schema is selected.
statement ok
SET openivm_metadata_schema = 'Control Space';

statement ok
SET openivm_internal_schema = 'Lake Internal';

statement ok
SET openivm_cascade_refresh = 'off';

statement ok
USE dl.s1;

statement ok
CREATE TABLE window_items (g INTEGER, x INTEGER);

statement ok
CREATE TABLE dl."Other Schema".window_items (g INTEGER, x INTEGER);

statement ok
INSERT INTO window_items VALUES (1,10),(1,20),(2,30);

statement ok
INSERT INTO dl."Other Schema".window_items VALUES (1,100),(2,200);

statement ok
CREATE MATERIALIZED VIEW "Window.Parent" AS SELECT g, x FROM window_items;

statement ok
CREATE MATERIALIZED VIEW window_child AS
SELECT g, x, SUM(x) OVER (PARTITION BY g) AS total FROM "Window.Parent";

# Emulate a database created before original-SQL sources were qualified. The
# public parent name must be recovered from persisted physical-source metadata.
statement ok
CREATE MATERIALIZED VIEW window_legacy_child AS
SELECT g, x, SUM(x) OVER (PARTITION BY g) AS total FROM "Window.Parent";

statement ok
UPDATE internal_schema_host."Control Space".openivm_views
SET sql_string = 'SELECT g, x, SUM(x) OVER (PARTITION BY g) AS total FROM "Window.Parent"'
WHERE view_sql_name = 'window_legacy_child';

# A CTE reference must stay unqualified; only the two underlying table references bind.
# Spaces/comments in qualified identifiers must not corrupt the original SQL spans.
statement ok
CREATE MATERIALIZED VIEW window_mixed AS
WITH local_items AS (SELECT * FROM window_items)
SELECT a.g, a.x, b.x AS other_x, SUM(a.x + b.x) OVER (PARTITION BY a.g) AS total
FROM local_items a JOIN dl . "Other Schema" /* source */ . window_items b ON a.g = b.g;

query I
SELECT count(*) FROM internal_schema_host."Control Space".openivm_views WHERE view_sql_name IN ('window_child','window_legacy_child','window_mixed') AND type = 5;
