# Replacement uses the caller namespace and keeps the persisted internal placement.

statement ok
USE dl.s1;

statement ok
SET openivm_metadata_schema = 'Control Space';

statement ok
SET openivm_internal_schema = 'Elsewhere';

statement ok
SET openivm_stateful_auxstate = true;

