# Auxiliary creation must bind unqualified sources before the staged executor selects native metadata.
# A dot or parentheses inside a quoted parent MV name are identifier bytes, not qualification/functions.

statement ok
SET openivm_metadata_schema = 'Control Space';

statement ok
SET openivm_internal_schema = 'Lake Internal';

statement ok
SET openivm_stateful_auxstate = true;

statement ok
SET openivm_distinct_aux_state = true;

statement ok
SET openivm_snapshot_publication = false;

statement ok
USE dl.s1;

statement ok
CREATE TABLE namespace_items (g INTEGER, x INTEGER);

statement ok
INSERT INTO namespace_items VALUES (1,10),(1,10),(1,20),(2,30),(3,NULL);

statement ok
CREATE MATERIALIZED VIEW "Parent.MV(quoted)" AS SELECT g, x FROM namespace_items;

statement ok
CREATE MATERIALIZED VIEW inner_direct AS SELECT g, SUM(x) AS n FROM (SELECT DISTINCT g, x FROM namespace_items) d GROUP BY g;

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.inner_direct EXCEPT ALL SELECT g, SUM(x) FROM (SELECT DISTINCT g, x FROM dl.s1.namespace_items) d GROUP BY g) UNION ALL (SELECT g, SUM(x) FROM (SELECT DISTINCT g, x FROM dl.s1.namespace_items) d GROUP BY g EXCEPT ALL SELECT * FROM dl.s1.inner_direct));
----
0

statement ok
CREATE MATERIALIZED VIEW inner_chained AS SELECT g, SUM(x) AS n FROM (SELECT DISTINCT g, x FROM "Parent.MV(quoted)") d GROUP BY g;

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.inner_chained EXCEPT ALL SELECT g, SUM(x) FROM (SELECT DISTINCT g, x FROM dl.s1."Parent.MV(quoted)") d GROUP BY g) UNION ALL (SELECT g, SUM(x) FROM (SELECT DISTINCT g, x FROM dl.s1."Parent.MV(quoted)") d GROUP BY g EXCEPT ALL SELECT * FROM dl.s1.inner_chained));
----
0

statement ok
CREATE MATERIALIZED VIEW counted_chained AS SELECT g, COUNT(DISTINCT x) AS n FROM "Parent.MV(quoted)" GROUP BY g;

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.counted_chained EXCEPT ALL SELECT g, COUNT(DISTINCT x) FROM dl.s1."Parent.MV(quoted)" GROUP BY g) UNION ALL (SELECT g, COUNT(DISTINCT x) FROM dl.s1."Parent.MV(quoted)" GROUP BY g EXCEPT ALL SELECT * FROM dl.s1.counted_chained));
----
0

query TIT
SELECT v.view_sql_name, v.type, t.schema_name FROM internal_schema_host."Control Space".openivm_views v JOIN duckdb_tables() t ON t.table_name = CASE v.view_sql_name WHEN 'counted_chained' THEN 'openivm_aux_' ELSE 'openivm_distinct_count_' END || v.view_name WHERE v.view_sql_name IN ('inner_direct','inner_chained','counted_chained') AND t.database_name = 'dl' ORDER BY v.view_sql_name;
----
counted_chained	11	Lake Internal
inner_chained	8	Lake Internal
inner_direct	8	Lake Internal

