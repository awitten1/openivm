# Dropping one same-named MV leaves the other intact; final cleanup removes all state.
statement ok
DROP VIEW dl."Other Schema".totals;

query I
SELECT count(*) FROM internal_schema_host."Control Space".openivm_views WHERE view_sql_name = 'totals';
----
1

