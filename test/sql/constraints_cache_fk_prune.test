# name: test/sql/constraints_cache_fk_prune.test
# description: RELY FK constraint-cache declarations prune FK-redundant join delta terms.
# group: [sql]

require openivm

statement ok
SET openivm_skip_empty_deltas = false;

# Baseline with an empty constraints cache: a two-sided append on child+parent
# keeps the child-delta/full-parent arm and the higher-order both-deltas arm.
statement ok
CREATE TABLE nofk_dim(product_id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE nofk_fact(sale_id INTEGER, product_id INTEGER, amount INTEGER);

statement ok
INSERT INTO nofk_dim VALUES (1, 'widget'), (2, 'gadget');

statement ok
INSERT INTO nofk_fact VALUES (10, 1, 100), (11, 2, 200);

statement ok
CREATE MATERIALIZED VIEW nofk_mv AS
    SELECT f.sale_id, d.name, f.amount
    FROM nofk_fact f JOIN nofk_dim d ON f.product_id = d.product_id;

statement ok
INSERT INTO nofk_dim VALUES (3, 'thing');

statement ok
INSERT INTO nofk_fact VALUES (12, 3, 300);

statement ok
CREATE TABLE nofk_refresh_sql AS
SELECT stmt_order, sql
FROM openivm_compile_with_facts(
    'nofk_mv', '{"target_dialect":"duckdb","compile_only":true,"assume_insert_only":true}')
WHERE stmt_kind = 'data';

query I
SELECT
    count(*) FILTER (
        WHERE contains(sql, 'openivm_delta_nofk_fact')
          AND contains(sql, 'openivm_delta_nofk_dim')
    ) = 1
    AND count(*) FILTER (
        WHERE contains(sql, 'openivm_delta_nofk_fact')
          AND NOT contains(sql, 'openivm_delta_nofk_dim')
    ) >= 1
FROM nofk_refresh_sql;
----
true

statement ok
PRAGMA refresh('nofk_mv');

query I
SELECT (SELECT count(*) FROM (
    SELECT f.sale_id, d.name, f.amount
    FROM nofk_fact f JOIN nofk_dim d ON f.product_id = d.product_id
    EXCEPT ALL SELECT * FROM nofk_mv
)) = 0 AND (SELECT count(*) FROM (
    SELECT * FROM nofk_mv
    EXCEPT ALL
    SELECT f.sale_id, d.name, f.amount
    FROM nofk_fact f JOIN nofk_dim d ON f.product_id = d.product_id
)) = 0;
----
true

# The same physical schema, but with a trusted RELY FK declared only through
# openivm_constraints_cache. The child-delta/full-parent arm remains, while the
# higher-order child-delta/parent-delta arm is pruned.
statement ok
CREATE TABLE ccfk_dim(product_id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE ccfk_fact(sale_id INTEGER, product_id INTEGER, amount INTEGER);

statement ok
INSERT INTO ccfk_dim VALUES (1, 'widget'), (2, 'gadget');

statement ok
INSERT INTO ccfk_fact VALUES (10, 1, 100), (11, 2, 200);

statement ok
CREATE MATERIALIZED VIEW ccfk_mv AS
    SELECT f.sale_id, d.name, f.amount
    FROM ccfk_fact f JOIN ccfk_dim d ON f.product_id = d.product_id;

statement ok
INSERT INTO ccfk_dim VALUES (3, 'thing');

statement ok
INSERT INTO ccfk_fact VALUES (12, 3, 300);

statement ok
PRAGMA openivm_declare_rely_fk('ccfk_fact', 'product_id', 'ccfk_dim', 'product_id');

query ITTITI
SELECT table_name = current_database() || '.main.ccfk_fact', constraint_kind, columns_json,
       referenced_table = current_database() || '.main.ccfk_dim', referenced_columns_json, is_trusted
FROM openivm_constraints_cache
WHERE table_name = current_database() || '.main.ccfk_fact';
----
true	RELY_FK	["product_id"]	true	["product_id"]	true

statement ok
CREATE TABLE ccfk_refresh_sql AS
SELECT stmt_order, sql
FROM openivm_compile_with_facts(
    'ccfk_mv', '{"target_dialect":"duckdb","compile_only":true,"assume_insert_only":true}')
WHERE stmt_kind = 'data';

query I
SELECT
    count(*) FILTER (
        WHERE contains(sql, 'openivm_delta_ccfk_fact')
          AND contains(sql, 'openivm_delta_ccfk_dim')
    ) = 0
    AND count(*) FILTER (
        WHERE contains(sql, 'openivm_delta_ccfk_fact')
          AND NOT contains(sql, 'openivm_delta_ccfk_dim')
    ) >= 1
FROM ccfk_refresh_sql;
----
true

query I
SELECT
    ((SELECT sum((length(sql) - length(replace(sql, 'UNION ALL', ''))) / length('UNION ALL'))
      FROM nofk_refresh_sql)
     >
     (SELECT sum((length(sql) - length(replace(sql, 'UNION ALL', ''))) / length('UNION ALL'))
      FROM ccfk_refresh_sql));
----
true

statement ok
PRAGMA refresh('ccfk_mv');

query I
SELECT (SELECT count(*) FROM (
    SELECT f.sale_id, d.name, f.amount
    FROM ccfk_fact f JOIN ccfk_dim d ON f.product_id = d.product_id
    EXCEPT ALL SELECT * FROM ccfk_mv
)) = 0 AND (SELECT count(*) FROM (
    SELECT * FROM ccfk_mv
    EXCEPT ALL
    SELECT f.sale_id, d.name, f.amount
    FROM ccfk_fact f JOIN ccfk_dim d ON f.product_id = d.product_id
)) = 0;
----
true

query III
SELECT sale_id, name, amount FROM ccfk_mv ORDER BY sale_id;
----
10	widget	100
11	gadget	200
12	thing	300

statement ok
SET openivm_skip_empty_deltas = true;

# Qualified declarations must not authorize pruning for same-named sources in
# another schema. Repeat with control metadata moved away from the sources.
foreach placement main FK_Control

statement ok
SET openivm_metadata_schema='${placement}';
CREATE SCHEMA fk_a;
CREATE SCHEMA fk_b;
CREATE TABLE fk_a.dim(k INTEGER PRIMARY KEY);
CREATE TABLE fk_a.fact(k INTEGER);
INSERT INTO fk_a.dim VALUES(1);
INSERT INTO fk_a.fact VALUES(1);
CREATE TABLE fk_b.dim(k INTEGER PRIMARY KEY);
CREATE TABLE fk_b.fact(k INTEGER);
INSERT INTO fk_b.dim VALUES(1);
INSERT INTO fk_b.fact VALUES(1),(2);
CREATE MATERIALIZED VIEW schema_fk_mv AS
SELECT f.k FROM fk_b.fact f JOIN fk_b.dim d ON f.k=d.k;

statement ok
PRAGMA openivm_declare_rely_fk('fk_a.fact','k','fk_a.dim','k');

statement ok
INSERT INTO fk_b.dim VALUES(2),(3);
UPDATE fk_b.dim SET k=4 WHERE k=3;
DELETE FROM fk_b.dim WHERE k=4;

statement ok
PRAGMA refresh('schema_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM schema_fk_mv EXCEPT ALL SELECT f.k FROM fk_b.fact f JOIN fk_b.dim d ON f.k=d.k)
UNION ALL (SELECT f.k FROM fk_b.fact f JOIN fk_b.dim d ON f.k=d.k EXCEPT ALL SELECT * FROM schema_fk_mv));
----
0

statement ok
DROP VIEW schema_fk_mv;
DROP SCHEMA fk_a CASCADE;
DROP SCHEMA fk_b CASCADE;

endloop

# Enforced FKs also name an exact target schema. A native FK to fk_parent.dim
# says nothing about a join against another schema's dimension.
statement ok
CREATE SCHEMA fk_parent;
CREATE SCHEMA fk_joined;
CREATE TABLE fk_parent.dim(k INTEGER PRIMARY KEY);
INSERT INTO fk_parent.dim VALUES(1),(2);
CREATE TABLE fk_parent.fact(k INTEGER REFERENCES fk_parent.dim(k));
INSERT INTO fk_parent.fact VALUES(1),(2);
CREATE TABLE fk_joined.dim(k INTEGER PRIMARY KEY);
INSERT INTO fk_joined.dim VALUES(1);
CREATE MATERIALIZED VIEW enforced_schema_fk_mv AS
SELECT f.k FROM fk_parent.fact f JOIN fk_joined.dim d ON f.k=d.k;
INSERT INTO fk_joined.dim VALUES(2);

statement ok
PRAGMA refresh('enforced_schema_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM enforced_schema_fk_mv EXCEPT ALL SELECT f.k FROM fk_parent.fact f JOIN fk_joined.dim d ON f.k=d.k)
UNION ALL (SELECT f.k FROM fk_parent.fact f JOIN fk_joined.dim d ON f.k=d.k EXCEPT ALL SELECT * FROM enforced_schema_fk_mv));
----
0

# Binding declarations uses the caller's schema search path, preserves quoted
# dots/quotes, and remains distinct across attached catalogs.
statement ok
ATTACH ':memory:' AS fk_peer;
CREATE SCHEMA "FK.Space";
CREATE TABLE "FK.Space"."d""im"(k INTEGER PRIMARY KEY);
CREATE TABLE "FK.Space"."f""act"(k INTEGER);
INSERT INTO "FK.Space"."d""im" VALUES(1);
INSERT INTO "FK.Space"."f""act" VALUES(1);
CREATE TABLE fk_peer.main."d""im"(k INTEGER PRIMARY KEY);
CREATE TABLE fk_peer.main."f""act"(k INTEGER);
INSERT INTO fk_peer.main."d""im" VALUES(1);
INSERT INTO fk_peer.main."f""act" VALUES(1),(2);
CREATE MATERIALIZED VIEW quoted_fk_mv AS
SELECT f.k FROM fk_peer.main."f""act" f JOIN fk_peer.main."d""im" d ON f.k=d.k;

statement ok
SET search_path='"FK.Space"';

statement ok
PRAGMA openivm_declare_rely_fk('"f""act"','["k"]','"d""im"','["k"]');

statement ok
SET search_path='main';

statement ok
INSERT INTO fk_peer.main."d""im" VALUES(2);

statement ok
PRAGMA refresh('quoted_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM quoted_fk_mv EXCEPT ALL SELECT f.k FROM fk_peer.main."f""act" f JOIN fk_peer.main."d""im" d ON f.k=d.k)
UNION ALL (SELECT f.k FROM fk_peer.main."f""act" f JOIN fk_peer.main."d""im" d ON f.k=d.k EXCEPT ALL SELECT * FROM quoted_fk_mv));
----
0

statement error
PRAGMA openivm_declare_rely_fk('"FK.Space"."f""act"','missing','"FK.Space"."d""im"','k');
----
Column with name missing does not exist

# Declarations belong to table incarnations. Drop/recreate invalidates either
# endpoint; rollback retains the assertion; committed CTAS invalidates it.
load __TEST_DIR__/fk_generations.db

statement ok
CREATE TABLE dim(k INTEGER PRIMARY KEY);
CREATE TABLE fact(k INTEGER);
INSERT INTO dim VALUES(1);
INSERT INTO fact VALUES(1);

statement ok
PRAGMA openivm_declare_rely_fk('fact','k','dim','k');

# Native tokens survive reopen, independently of the control-schema placement.
restart

statement ok
BEGIN;
DROP TABLE fact;
CREATE TABLE fact(k INTEGER);
ROLLBACK;
DROP TABLE fact;
CREATE TABLE fact(k INTEGER);
INSERT INTO fact VALUES(1),(2);
CREATE MATERIALIZED VIEW incarnation_mv AS SELECT f.k FROM fact f JOIN dim d ON f.k=d.k;
INSERT INTO dim VALUES(2),(3);
UPDATE dim SET k=4 WHERE k=3;
DELETE FROM dim WHERE k=4;

statement ok
PRAGMA refresh('incarnation_mv');

query I
SELECT count(*) FROM ((SELECT * FROM incarnation_mv EXCEPT ALL SELECT f.k FROM fact f JOIN dim d ON f.k=d.k)
UNION ALL (SELECT f.k FROM fact f JOIN dim d ON f.k=d.k EXCEPT ALL SELECT * FROM incarnation_mv));
----
0

# A valid redeclaration can be reused until a native replacement changes the
# source object. This replacement introduces an old orphan without an assertion.
statement ok
PRAGMA openivm_declare_rely_fk('fact','k','dim','k');

statement ok
CREATE OR REPLACE TABLE fact AS SELECT 1::INTEGER k UNION ALL SELECT 2 UNION ALL SELECT 5;
INSERT INTO dim VALUES(5);

statement ok
PRAGMA refresh('incarnation_mv');

query I
SELECT count(*) FROM ((SELECT * FROM incarnation_mv EXCEPT ALL SELECT f.k FROM fact f JOIN dim d ON f.k=d.k)
UNION ALL (SELECT f.k FROM fact f JOIN dim d ON f.k=d.k EXCEPT ALL SELECT * FROM incarnation_mv));
----
0

# Column identity changes and table renames retire assertions too; recreating a
# name must never revive trust granted to its predecessor.
statement ok
CREATE TABLE alter_parent(k INTEGER);
CREATE TABLE alter_child(k INTEGER,extra INTEGER);
INSERT INTO alter_parent VALUES(1);
INSERT INTO alter_child VALUES(1,7);

statement ok
PRAGMA openivm_declare_rely_fk('alter_child','k','alter_parent','k');

statement ok
ALTER TABLE alter_child DROP COLUMN k;
ALTER TABLE alter_child ADD COLUMN k INTEGER DEFAULT 2;
CREATE MATERIALIZED VIEW altered_fk_mv AS SELECT c.k FROM alter_child c JOIN alter_parent p ON c.k=p.k;
INSERT INTO alter_parent VALUES(2);

statement ok
PRAGMA refresh('altered_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM altered_fk_mv EXCEPT ALL SELECT c.k FROM alter_child c JOIN alter_parent p ON c.k=p.k)
UNION ALL (SELECT c.k FROM alter_child c JOIN alter_parent p ON c.k=p.k EXCEPT ALL SELECT * FROM altered_fk_mv));
----
0

statement ok
CREATE TABLE rename_child(k INTEGER);
INSERT INTO rename_child VALUES(1);

statement ok
PRAGMA openivm_declare_rely_fk('rename_child','k','alter_parent','k');

statement ok
ALTER TABLE rename_child RENAME TO previous_child;
CREATE TABLE rename_child(k INTEGER);
INSERT INTO rename_child VALUES(3);
CREATE MATERIALIZED VIEW renamed_fk_mv AS SELECT c.k FROM rename_child c JOIN alter_parent p ON c.k=p.k;
INSERT INTO alter_parent VALUES(3);

statement ok
PRAGMA refresh('renamed_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM renamed_fk_mv EXCEPT ALL SELECT c.k FROM rename_child c JOIN alter_parent p ON c.k=p.k)
UNION ALL (SELECT c.k FROM rename_child c JOIN alter_parent p ON c.k=p.k EXCEPT ALL SELECT * FROM renamed_fk_mv));
----
0

# Match native SQL's two-part catalog.table resolution, including quoted aliases
# and ambiguity with an equally named schema in the current database.
statement ok
ATTACH ':memory:' AS "FK.Data";
CREATE TABLE "FK.Data".child(k INTEGER);
CREATE TABLE "FK.Data".parent(k INTEGER);
INSERT INTO "FK.Data".parent VALUES(1);
INSERT INTO "FK.Data".child VALUES(1),(1);

statement ok
PRAGMA openivm_declare_rely_fk('"FK.Data".child','k','"FK.Data".parent','k');

statement ok
CREATE MATERIALIZED VIEW qualified_catalog_fk_mv AS SELECT c.k FROM "FK.Data".child c JOIN "FK.Data".parent p ON c.k=p.k;
INSERT INTO "FK.Data".parent VALUES(2),(3);
INSERT INTO "FK.Data".child VALUES(2),(3),(3);
UPDATE "FK.Data".child SET k=2 WHERE k=3;
DELETE FROM "FK.Data".child WHERE k=1;

statement ok
PRAGMA refresh('qualified_catalog_fk_mv');

query I
SELECT count(*) FROM ((SELECT * FROM qualified_catalog_fk_mv EXCEPT ALL SELECT c.k FROM "FK.Data".child c JOIN "FK.Data".parent p ON c.k=p.k)
UNION ALL (SELECT c.k FROM "FK.Data".child c JOIN "FK.Data".parent p ON c.k=p.k EXCEPT ALL SELECT * FROM qualified_catalog_fk_mv));
----
0

statement ok
CREATE SCHEMA "FK.Data";

statement error
PRAGMA openivm_declare_rely_fk('"FK.Data".child','k','"FK.Data".parent','k');
----
Ambiguous reference to catalog or schema

statement ok
PRAGMA openivm_declare_rely_fk('"FK.Data".main.child','k','"FK.Data".main.parent','k');
DROP SCHEMA "FK.Data";
DROP VIEW qualified_catalog_fk_mv;
